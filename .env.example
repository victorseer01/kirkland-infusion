# Set in Vercel: posts validated form payloads as JSON.
# Leave empty in local dev to no-op (submissions still validate; server logs them).
FORM_WEBHOOK_URL=

# Destination for every "Refer a Patient" CTA (navbar, hero, mobile menu, etc.).
# Set to the hosted referral form/portal URL, e.g. https://refer.oaoc.example.com.
# Must be prefixed NEXT_PUBLIC_ so it is available in the browser.
# When unset, the CTAs fall back to the on-site referral form (/physicians#refer).
# An http/https value opens in a new tab.
NEXT_PUBLIC_REFERRAL_URL=
