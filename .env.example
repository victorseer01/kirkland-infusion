# Set in Vercel: posts validated form payloads as JSON.
# Leave empty in local dev to no-op (submissions still validate; server logs them).
FORM_WEBHOOK_URL=

# OAOC partner-practice referral portal URL, e.g. https://refer.oaoc.example.com.
# The site-wide "Refer a Patient" buttons always open the on-site options
# section (/physicians#how-to-refer); when this is set, the OAOC portal is shown
# there as an extra online-referral option alongside the IntakeQ portal.
# Must be prefixed NEXT_PUBLIC_ so it is available in the browser. Opens in a new tab.
NEXT_PUBLIC_REFERRAL_URL=
